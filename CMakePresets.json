{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WPM_PACKAGE_DEBUG": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WPM_PACKAGE_DEBUG": "OFF"
      }
    },
    {
      "name": "x86-debug",
      "inherits": "debug-base",
      "cacheVariables": { "TCC_TARGET": "x86", "TCC_TOOLCHAIN": "tcc-bootstrap" }
    },
    {
      "name": "x64-debug",
      "inherits": "debug-base",
      "cacheVariables": { "TCC_TARGET": "x64", "TCC_TOOLCHAIN": "msvc" }
    },
    {
      "name": "arm64-debug",
      "inherits": "debug-base",
      "cacheVariables": { "TCC_TARGET": "arm64", "TCC_TOOLCHAIN": "msvc" }
    },
    {
      "name": "x86-release",
      "inherits": "release-base",
      "cacheVariables": { "TCC_TARGET": "x86", "TCC_TOOLCHAIN": "tcc-bootstrap" }
    },
    {
      "name": "x64-release",
      "inherits": "release-base",
      "cacheVariables": { "TCC_TARGET": "x64", "TCC_TOOLCHAIN": "msvc" }
    },
    {
      "name": "arm64-release",
      "inherits": "release-base",
      "cacheVariables": { "TCC_TARGET": "arm64", "TCC_TOOLCHAIN": "msvc" }
    }
  ],
  "buildPresets": [
    { "name": "x86-debug", "configurePreset": "x86-debug" },
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "arm64-debug", "configurePreset": "arm64-debug" },
    { "name": "x86-release", "configurePreset": "x86-release" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "arm64-release", "configurePreset": "arm64-release" }
  ]
}
